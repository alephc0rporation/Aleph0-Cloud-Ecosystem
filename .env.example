# Copy to .env (never committed). Dev-only values.
# No quotes and no `$` in values: the Makefile reads this file too.

# PostgreSQL superuser (docker compose only)
POSTGRES_PASSWORD=postgres

# Keycloak admin console (http://localhost:8081)
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin

# API
HTTP_ADDR=:8080
DATABASE_URL=postgres://api:api@localhost:5432/api?sslmode=disable
OIDC_ISSUER=http://localhost:8081/realms/aleph0
OIDC_AUDIENCE=api

# OpenStack (the dev cluster from deploy/). Replace the two passwords with the files in
# deploy/kolla/dev/credentials/ (see README). Until then the API starts, tenants work, and
# creating or deleting a project fails.
OS_AUTH_URL=http://10.10.0.10:5000/v3
OS_API_USERNAME=aleph0-api
OS_API_PASSWORD=fill-from-deploy-credentials
OS_PROVISIONER_USERNAME=aleph0-provisioner
OS_PROVISIONER_PASSWORD=fill-from-deploy-credentials
REGIONS=[{"id":"ro-1","name":"Romania 1","openstack_region":"RegionOne","external_network":"public"}]
LIMIT_TENANTS_PER_USER=3
LIMIT_PROJECTS_PER_TENANT=10

# Web (only VITE_* variables reach the browser)
VITE_OIDC_AUTHORITY=http://localhost:8081/realms/aleph0
VITE_OIDC_CLIENT_ID=web
